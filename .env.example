# ---------------------------------------------------------------------------
# MotionForge environment configuration
# Copy to `.env` and adjust. All variables are optional in development: the app
# falls back to a local, offline AI planner and filesystem storage.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
# Dev default is a local SQLite file. To use Postgres, swap the datasource
# provider in packages/database/prisma/schema.prisma and use a URL below.
DATABASE_URL="file:./dev.db"

# --- Auth ---------------------------------------------------------------
# HMAC secret used to sign session cookies. CHANGE THIS IN PRODUCTION.
AUTH_SECRET="dev-only-secret-change-me"

# --- Storage ------------------------------------------------------------
# `local` writes to ./storage, `s3` uses the S3-compatible variables below.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="motionforge"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# --- AI providers -------------------------------------------------------
# The provider layer is provider-independent. Set AI_PROVIDER to `openai`,
# `anthropic`, `openai-compatible`, or `local`.
# `local` is the built-in offline creative-director engine (default).
AI_PROVIDER="local"

# OpenAI / OpenAI-compatible (OpenAI, Groq, OpenRouter, Together, Ollama...)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# --- Renderer -----------------------------------------------------------
# Absolute or relative path where rendered MP4s are written.
RENDER_OUTPUT_DIR="./storage/renders"
# Concurrency of the render worker process.
RENDER_CONCURRENCY="1"
# Remotion license key (required by Remotion for commercial use).
REMOTION_LICENSE_KEY=""
